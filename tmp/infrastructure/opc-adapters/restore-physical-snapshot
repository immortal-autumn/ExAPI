#!/usr/bin/env bash
set -euo pipefail
umask 077

. /protected/lib/lib-exapi-storage.sh
exapi_load_s3_credentials

[[ "${EXAPI_ROLLOUT_ID:-}" =~ ^[A-Za-z0-9._-]+$ ]] || { printf 'unsafe rollout ID\n' >&2; exit 1; }
[[ "${EXAPI_SNAPSHOT_PROVIDER:-}" == minio-pg-basebackup ]] || { printf 'unexpected snapshot provider\n' >&2; exit 1; }
[[ -n "${EXAPI_SNAPSHOT_ID:-}" && -n "${EXAPI_SNAPSHOT_TARGET:-}" ]] || { printf 'snapshot identity is incomplete\n' >&2; exit 1; }

SRC=${EXAPI_RELEASE_ROOT:-/home/opc/src/exapi-release-f8cee085c3e7d815d5144659d3a92720f9aa8e95}
POSTGRES_IMAGE=${EXAPI_POSTGRES_IMAGE:-postgres@sha256:9a8afca54e7861fd90fab5fdf4c42477a6b1cb7d293595148e674e0a3181de15}
[[ "$POSTGRES_IMAGE" =~ @sha256:[0-9a-f]{64}$ ]] || { printf 'postgres image must be digest pinned\n' >&2; exit 1; }
expected_counts_file=${EXAPI_RESTORED_COUNTS_FILE:-$SRC/tmp/rollouts/$EXAPI_ROLLOUT_ID/logical-restore/logical-restore-evidence.json}
[[ -r "$expected_counts_file" ]] || { printf 'logical restore counts evidence is unreadable\n' >&2; exit 1; }
expected_counts=$(python3 - "$expected_counts_file" <<'PY'
import json, sys
data=json.load(open(sys.argv[1], encoding="utf-8"))
counts=data.get("database_counts")
keys=("users", "active_accounts", "active_api_keys", "batch_image_jobs", "schema_migrations")
if not isinstance(counts, dict) or any(type(counts.get(key)) is not int or counts[key] < 0 for key in keys):
    raise SystemExit("logical restore evidence has invalid database_counts")
print("|".join(str(counts[key]) for key in keys))
PY
)
tmp_dir="$SRC/tmp/snapshot-restore/$EXAPI_ROLLOUT_ID"
mkdir -p "$tmp_dir"
chmod 700 "$tmp_dir"
fifo="$tmp_dir/snapshot.fifo"
checksum="$tmp_dir/download.sha256"
container="exapi-snapshot-restore-${EXAPI_ROLLOUT_ID//[^A-Za-z0-9_.-]/-}"
volume="${container}-data"
read -r bucket key < <(exapi_parse_s3 "$EXAPI_SNAPSHOT_TARGET")
head=$(exapi_aws s3api head-object --bucket "$bucket" --key "$key" --version-id "$EXAPI_SNAPSHOT_ID" --output json)
expected_sha=$(jq -er '.Metadata.sha256' <<<"$head")
retention=$(jq -er '.ObjectLockRetainUntilDate' <<<"$head" | python3 -c 'import sys; print(sys.stdin.read().strip().replace("+00:00", "Z"))')
[[ "$(jq -r .ObjectLockMode <<<"$head")" == COMPLIANCE ]] || { printf 'snapshot is not immutable\n' >&2; exit 1; }

cleanup() {
  unlink "$fifo" >/dev/null 2>&1 || true
  docker rm -f "$container" >/dev/null 2>&1 || true
  docker volume rm "$volume" >/dev/null 2>&1 || true
}
trap cleanup EXIT
docker rm -f "$container" >/dev/null 2>&1 || true
docker volume rm "$volume" >/dev/null 2>&1 || true
mkfifo -m 600 "$fifo"
docker volume create --label "exapi.rollout_id=$EXAPI_ROLLOUT_ID" --label exapi.restore_source=physical "$volume" >/dev/null

exapi_aws s3api get-object --bucket "$bucket" --key "$key" --version-id "$EXAPI_SNAPSHOT_ID" "$fifo" >/dev/null &
download_pid=$!
python3 "$SRC/deploy/ops/stream_hash.py" "$checksum" <"$fifo" |
  age --decrypt -i /offline/identities/snapshot.agekey |
  docker run --rm --network none -i --user 0 -v "$volume:/target" --entrypoint /bin/sh "$POSTGRES_IMAGE" -ec 'tar -xzpf - -C /target'
wait "$download_pid"
actual_sha=$(tr -d '\r\n' < "$checksum")
actual_sha=${actual_sha#sha256:}
[[ "$actual_sha" == "$expected_sha" ]] || { printf 'snapshot checksum mismatch\n' >&2; exit 1; }

docker run -d --name "$container" --network none -e PGDATA=/var/lib/postgresql/data \
  -v "$volume:/var/lib/postgresql/data" "$POSTGRES_IMAGE" >/dev/null
for _ in $(seq 1 60); do
  docker exec "$container" pg_isready -U sub2api -d sub2api >/dev/null 2>&1 && break
  sleep 1
done
docker exec "$container" pg_isready -U sub2api -d sub2api >/dev/null
network=$(docker inspect "$container" --format '{{.HostConfig.NetworkMode}}')
[[ "$network" == none ]] || { printf 'snapshot target has network access\n' >&2; exit 1; }
docker exec "$container" psql -v ON_ERROR_STOP=1 -U sub2api -d sub2api -Atqc '
DO $$ BEGIN
  IF to_regclass('"'"'public.users'"'"') IS NULL OR to_regclass('"'"'public.accounts'"'"') IS NULL OR
     to_regclass('"'"'public.api_keys'"'"') IS NULL OR to_regclass('"'"'public.schema_migrations'"'"') IS NULL THEN
    RAISE EXCEPTION '"'"'required table missing'"'"';
  END IF;
END $$;
SELECT (SELECT COUNT(*) FROM users),(SELECT COUNT(*) FROM accounts WHERE deleted_at IS NULL),
  (SELECT COUNT(*) FROM api_keys WHERE deleted_at IS NULL),(SELECT COUNT(*) FROM batch_image_jobs),
  (SELECT COUNT(*) FROM schema_migrations);
' | tail -n 1 | grep -Fx "$expected_counts"
restored=$(date -u +%Y-%m-%dT%H:%M:%SZ)
jq -n \
  --arg rollout_id "$EXAPI_ROLLOUT_ID" --arg provider "$EXAPI_SNAPSHOT_PROVIDER" \
  --arg snapshot_id "$EXAPI_SNAPSHOT_ID" --arg disposable_target "$container" \
  --arg restored_at "$restored" --arg retention_until "$retention" \
  '{rollout_id:$rollout_id,provider:$provider,snapshot_id:$snapshot_id,
    disposable_target:$disposable_target,restored_at:$restored_at,retention_until:$retention_until,
    writer_quiesced:true,checkpoint_completed:true,verified:true,egress_denied:true,
    integrity_verified:true,decryption_verified:true}'
