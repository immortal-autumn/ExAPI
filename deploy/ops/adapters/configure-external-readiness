#!/usr/bin/env bash
set -euo pipefail
umask 077

proof=${EXAPI_OFFHOST_MONITOR_PROOF_FILE:-/protected/monitoring/offhost-readiness-proof.json}
[[ -r "$proof" ]] || { printf 'off-host monitor proof is unreadable\n' >&2; exit 1; }
python3 - "$proof" "$(hostname)" <<'PY'
import datetime,json,sys
d=json.load(open(sys.argv[1],encoding="utf-8"))
if d.get("schema_version")!=1:
    raise SystemExit("unsupported off-host monitor proof schema")
if not isinstance(d.get("monitor_host"),str) or not d["monitor_host"] or d["monitor_host"]==sys.argv[2]:
    raise SystemExit("readiness monitor is not off-host")
if d.get("target_url")!="https://sub2api.research.for-immortal.cn/ready":
    raise SystemExit("readiness monitor target mismatch")
probe=d.get("last_probe")
if not isinstance(probe,dict) or probe.get("monitor_host")!=d["monitor_host"]:
    raise SystemExit("off-host monitor omitted its latest probe")
try: observed=datetime.datetime.fromisoformat(probe["observed_at"].replace("Z","+00:00"))
except (KeyError,TypeError,ValueError) as exc: raise SystemExit("off-host probe timestamp is invalid") from exc
now=datetime.datetime.now(datetime.timezone.utc)
if observed<now-datetime.timedelta(minutes=5) or observed>now+datetime.timedelta(minutes=2):
    raise SystemExit("off-host readiness probe is stale or from the future")
print(json.dumps({"configured":True,"monitor_host":d["monitor_host"],"target_url":d["target_url"],"last_probe_at":probe["observed_at"]},sort_keys=True))
PY
